{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "laravel-tasks": {
            "type": "http",
            "url": "http://localhost:8000/mcp/tasks",
            "tools": [
                "*"
            ]
        }
    }
}
